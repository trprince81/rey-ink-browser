{
  "manifest_version": 3,
  "name": "Rey ink - Actualizador",
  "version": "1.1.0",
  "description": "Agente de dispositivo y asistente de temporización de Rey ink.",
  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "https://www.megapersonals.com/*",
    "https://megapersonals.com/*",
    "https://rey-ink-browser.vercel.app/*"
  ],
  "background": {"service_worker":"background.js"},
  "action": {
    "default_title": "Rey ink - Actualizador",
    "default_popup": "popup.html"
  },
  "content_scripts": [{
    "matches": ["https://www.megapersonals.com/*", "https://megapersonals.com/*"],
    "js": ["content.js"],
    "css": ["overlay.css"],
    "run_at": "document_idle"
  }],
  "icons": {"16":"icon.svg","32":"icon.svg","48":"icon.svg","128":"icon.svg"}
}
