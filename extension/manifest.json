{
  "manifest_version": 3,
  "name": "Rey Ink — Control Remoto",
  "version": "3.5.0",
  "description": "Rey Ink — control remoto del navegador con mouse virtual invisible, clic, arrastre, rueda, teclado, pantalla y grabación.",
  "permissions": ["tabs", "scripting", "storage", "alarms", "debugger"],
  "host_permissions": ["<all_urls>", "https://rey-ink-browser.vercel.app/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Abrir Rey Ink" },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["recorder_boot.js"], "run_at": "document_start" }
  ],
  "web_accessible_resources": [
    { "resources": ["recorder.js"], "matches": ["<all_urls>"] }
  ]
}
