{
  "manifest_version": 3,
  "name": "Rey Ink Browser",
  "version": "1.0.0",
  "description": "Extensión de Rey Ink para ejecutar de forma fiable el botón de protección en la página.",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": {
    "default_title": "Rey Ink Browser",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
