<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Rey Ink â€” Control</title><style>*{box-sizing:border-box}body{margin:0;background:#08060f;color:#f7f4ff;font-family:system-ui,-apple-system,Segoe UI,sans-serif}.wrap{max-width:820px;margin:auto;padding:22px 14px 50px}.brand{display:flex;align-items:center;gap:13px;margin-bottom:18px}.logo{width:48px;height:48px;border-radius:15px;background:#7027ff;display:grid;place-items:center;font-size:25px;box-shadow:0 0 25px #7027ff55}.title{font-size:27px;font-weight:800}.muted{color:#aaa2b8;font-size:13px}.card{background:#15111f;border:1px solid #302541;border-radius:18px;padding:17px;margin:12px 0}.head,.topline{display:flex;justify-content:space-between;align-items:center;gap:10px}.head h2{margin:0;font-size:18px}.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:9px;margin-top:14px}.pc{border:1px solid #382a4d;background:#0f0b17;color:#fff;border-radius:13px;padding:14px;text-align:left;font-size:16px;font-weight:700;cursor:pointer}.pc:hover{border-color:#8b55ff}.dot{display:inline-block;width:9px;height:9px;border-radius:50%;background:#6b6472;margin-right:7px}.on{background:#35d58d}.hidden{display:none}.row{display:flex;gap:8px;flex-wrap:wrap}.row button,.action,.small{border:0;border-radius:10px;padding:10px 12px;background:#21172f;color:#fff;font-weight:700;cursor:pointer}.action{background:#7027ff;margin-top:12px}.danger{background:#a62b42!important}.msg{margin-top:12px;padding:11px;border-radius:10px;background:#0e0a16;color:#c9c1d7;font-size:13px}.err{color:#ff8f9a}.ok{color:#68e2a6}.input{width:100%;padding:13px;border-radius:11px;border:1px solid #3a2d50;background:#0b0811;color:#fff;font-size:16px}.label{display:block;margin:10px 0 6px;color:#bcb3c8;font-size:13px}.badge{padding:5px 9px;border-radius:999px;background:#21172f;font-size:12px}.pcname{font-size:18px}.sub{font-size:12px;color:#aaa2b8;margin-top:4px}@media(max-width:520px){.grid{grid-template-columns:1fr}}</style></head><body><main class="wrap"><div class="brand"><div class="logo">â™›</div><div><div class="title">Rey Ink</div><div class="muted">Control de tus 20 PCs</div></div></div><section id="listCard" class="card"><div class="topline"><h2>PCs disponibles</h2><span class="badge" id="status">Cargandoâ€¦</span></div><div class="grid" id="pcs"></div></section><section id="loginCard" class="card hidden"><div class="head"><h2 id="selected">PC1</h2><button class="small" id="change">Cambiar PC</button></div><label class="label">Usuario</label><input class="input" id="user" autocomplete="username"><label class="label">ContraseÃ±a</label><input class="input" id="pass" type="password" autocomplete="current-password"><button class="action" id="enter">Entrar</button><div class="msg" id="msg"></div></section><section id="controlCard" class="card hidden"><div class="topline"><h2 id="ctrlTitle">Control de PC1</h2><span class="ok">SesiÃ³n activa</span></div><div class="msg" id="result">Listo para enviar Ã³rdenes.</div><div class="row"><button data-cmd="get_state">Estado</button><button data-cmd="reload">Recargar</button><button data-cmd="back">AtrÃ¡s</button><button data-cmd="forward">Adelante</button><button data-cmd="new_tab">Nueva pestaÃ±a</button><button data-cmd="start_bot">Iniciar bot</button><button class="danger" data-cmd="stop_bot">Detener bot</button></div></section></main><script>async function api(b){const h={'content-type':'application/json'},t=sessionStorage.getItem('reyInkPhoneToken');if(t)h['x-phone-token']=t;const r=await fetch(location.pathname,{method:'POST',headers:h,body:JSON.stringify(b)});const s=await r.text();try{return JSON.parse(s)}catch{return{ok:false,error:'Respuesta invÃ¡lida del servidor'}}}function show(id){document.getElementById(id).classList.remove('hidden')}function hide(id){document.getElementById(id).classList.add('hidden')}async function load(){try{const d=await api({action:'list_devices'}),box=document.getElementById('pcs');box.innerHTML='';for(let n=1;n<=20;n++){const x=(d.devices||[]).find(v=>Number(v.pc_slot)===n),b=document.createElement('button');b.className='pc';b.innerHTML='<span class="pcname">PC'+n+'</span><div class="sub"><span class="dot '+(x&&x.is_online?'on':'')+'"></span>'+(x&&x.is_online?'En lÃ­nea':'Sin conexiÃ³n')+'</div>';b.onclick=()=>selectPc(n);box.appendChild(b)}document.getElementById('status').textContent='20 PCs'}catch(e){document.getElementById('status').textContent='Error'}}function selectPc(n){document.getElementById('selected').textContent='PC'+n;document.getElementById('user').value='PC'+n;document.getElementById('pass').value='';document.getElementById('msg').textContent='';hide('listCard');show('loginCard');hide('controlCard')}function back(){hide('loginCard');hide('controlCard');show('listCard')}async function login(){const m=document.getElementById('msg');m.textContent='Conectandoâ€¦';const d=await api({action:'login_pc',username:document.getElementById('user').value,password:document.getElementById('pass').value});if(!d.ok){m.innerHTML='<span class="err">'+(d.error||'No se pudo entrar')+'</span>';return}sessionStorage.setItem('reyInkPhoneToken',d.phone_token||'');hide('loginCard');show('controlCard');document.getElementById('ctrlTitle').textContent='Control de PC'+d.pc_slot;document.getElementById('result').textContent='PC'+d.pc_slot+' seleccionada. Puedes enviar Ã³rdenes.'}async function send(command){const r=await api({action:'command',command});document.getElementById('result').textContent=r.ok?'Orden enviada: '+command:(r.error||'Error')}document.getElementById('enter').onclick=login;document.getElementById('change').onclick=back;document.querySelectorAll('[data-cmd]').forEach(b=>b.onclick=()=>send(b.dataset.cmd));load();setInterval(load,10000);</script></body></html>
